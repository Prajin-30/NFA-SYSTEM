# CU-NFA Environment Configuration (Placeholders only - Never commit real credentials)

# Application Environment: 'development' | 'staging' | 'production' | 'demo'
APP_ENV=development

# Data Source: 'postgres' (Supabase) | 'json' (Isolated demo store)
DATA_SOURCE=postgres

# Server Port
PORT=4000

# Backend Express Session JWT Secret (Used for signing enriched session tokens)
JWT_SECRET=your_jwt_secret_minimum_32_characters_here

# PostgreSQL Database Connection (Supabase)
# For Supavisor Transaction Pooler (Port 6543):
# DATABASE_URL=postgres://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# For Direct / Session Mode (Port 5432):
# DATABASE_URL=postgres://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
DATABASE_URL=

# TLS Configuration: Set to 'true' for verified TLS in cloud/production, 'false' only for local mock testing
DATABASE_SSL=true

# Optional path to custom CA certificate file (uses system trusted CAs if omitted)
PG_CA_CERT=

# Supabase Project Endpoint
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Client-Facing Anon/Publishable Key
SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Server-Side Secret Service Role Key (STRICTLY CONFIDENTIAL - Server only)
# Required for Super Admin programmatic account creation, password resets, and admin auth operations
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Approved University Email Domains for User Onboarding (comma-separated)
APPROVED_EMAIL_DOMAINS=christuniversity.in,christ.edu

# Email Notification Configuration
# Provider: 'mock' (Default for local development & staging workflows; never sends real emails) | 'resend'
EMAIL_PROVIDER=mock

# Resend API Key (Configured on backend only; never expose to client)
RESEND_API_KEY=

# Resend Verified/Testing Sender Email Address
RESEND_FROM_EMAIL=onboarding@resend.dev

# Configured Recipient for Super Admin Email Delivery Testing
# (Must match the email address registered with your Resend account when using onboarding@resend.dev)
RESEND_TEST_RECIPIENT=prajin.s@btech.christuniversity.in
